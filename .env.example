# Where the contact form forwards to. Required — the form returns a
# "not configured" error without it.
#
# NOT a secret. Formspree form IDs are public by design (anyone can POST to this
# URL directly), so keeping it non-NEXT_PUBLIC_ is purely for swappability
# between staging and production — it is not a security boundary. Spam
# protection belongs in the Formspree dashboard and, if ever needed, a Vercel
# Firewall rate-limit rule on the path.
#
# A full URL rather than just the id so it can be pointed at an echo server
# (e.g. http://localhost:4000) to verify the payload without spending a real
# submission.
FORMSPREE_ENDPOINT=https://formspree.io/f/xovvdbgz

# Canonical origin for metadata, OG tags, and JSON-LD.
NEXT_PUBLIC_SITE_URL=https://saisrinu.in

# Set to any truthy value to short-circuit the contact action and return success
# without contacting Formspree. Use for local UI testing and demos.
# CONTACT_DRY_RUN=1
